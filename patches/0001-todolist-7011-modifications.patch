+// [ZH-ONLY] Load the embedded Chinese translation table compiled into the exe.
+BOOL CTransDictionary::LoadEmbeddedChinese()
+{
+	DeleteDictionary();
+
+	for (int i = 0; i < g_zhTableCount; i++)
+	{
+				CString sLine(g_zhTable[i].en);
+		sLine += _T("\t");
+		sLine += g_zhTable[i].zh;
+
+		CStringArray aLines;
+		aLines.Add(sLine);
+		int nLine = 0;
+		DICTITEM di;
+		if (!di.FromCsv(aLines, nLine))
+			continue;
+
+		CString sKey(di.GetTextIn());
+		DICTITEM* pOld = NULL;
+		if (Lookup(sKey, pOld))
+		{
+			di.Merge(*pOld);
+			delete pOld;
+		}
+		DICTITEM* pNew = new DICTITEM(di);
+		SetAt(sKey, pNew);
+	}
+
+	m_sDictFile = _T("@EmbeddedChinese");
+	m_sDictVersion = _T("1.0");
+	FixupDictionary();
+	return TRUE;
+}
