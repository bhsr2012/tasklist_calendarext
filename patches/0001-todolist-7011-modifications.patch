+
+	m_lcColumnTotals.SetFont(pFont);
+	m_lcTotalsLabels.SetFont(pFont);
+
+	CString sFontName;
+	int nFontSize = GraphicsMisc::GetFontNameAndPointSize(hFont, sFontName);
+
+	m_barChart.SetFont(sFontName, nFontSize);
+
+	return TRUE;
+}
