+
+			if (!map.Lookup((LPCTSTR)sKey, nDummy))
+			{
+				map[(LPCTSTR)sKey] = 0;
+				aItems.Add(sItem);
+			}
+		}
+	};
+
+	void CollectComboValues(const CToDoCtrlData& data, const TODOSTRUCTURE* pTDS, TDCCOMBOVALUES& values)
+	{
+		if (!pTDS)
+			return;
+
+		for (int nSubTask = 0; nSubTask < pTDS->GetSubTaskCount(); nSubTask++)
+		{
+			const TODOSTRUCTURE* pTDSChild = pTDS->GetSubTask(nSubTask);
+
+			if (!pTDSChild)
+				continue;
+
+			DWORD dwTaskID = pTDSChild->GetTaskID();
+			const TODOITEM* pTDI = data.GetTask(dwTaskID, FALSE);
+
+			if (pTDI)
+			{
+				for (int nItem = 0; nItem < pTDI->aAllocTo.GetSize(); nItem++)
+					values.AddUnique(values.aAllocTo, values.mapAllocTo, pTDI->aAllocTo[nItem]);
+
+				values.AddUnique(values.aAllocBy, values.mapAllocBy, pTDI->sAllocBy);
+				values.AddUnique(values.aStatus, values.mapStatus, pTDI->sStatus);
+
+				for (int nItem = 0; nItem < pTDI->aCategories.GetSize(); nItem++)
+					values.AddUnique(values.aCategory, values.mapCategory, pTDI->aCategories[nItem]);
+
+				for (int nItem = 0; nItem < pTDI->aTags.GetSize(); nItem++)
+					values.AddUnique(values.aTags, values.mapTags, pTDI->aTags[nItem]);
+
+				values.AddUnique(values.aVersion, values.mapVersion, pTDI->sVersion);
+			}
+
+			CollectComboValues(data, pTDSChild, values);
+		}
+	}
+}
