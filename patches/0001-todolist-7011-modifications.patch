+	}
+
+	m_lcTotalsLabels.SetBkColor(m_crBkgnd);
+	m_lcTotalsLabels.SetTextBkColor(m_crBkgnd);
+	ListView_SetExtendedListViewStyleEx(m_lcTotalsLabels, LVS_EX_DOUBLEBUFFER, LVS_EX_DOUBLEBUFFER);
