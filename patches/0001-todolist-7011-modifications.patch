+
+CString CToDoCtrlFind::FormatTaskAttribute(int nAttrib, const TODOITEM* pTDI) const
+{
+	CString sValue;
+
+	if (pTDI)
+	{
+		switch (nAttrib)
+		{
+		case TDCA_ALLOCTO:		sValue = m_data.FormatTaskAllocTo(pTDI);		break;
+		case TDCA_EQUIPMENT:	sValue = m_data.FormatTaskEquipment(pTDI);	break;
+		case TDCA_CATEGORY:		sValue = m_data.FormatTaskCategories(pTDI);	break;
+		case TDCA_TAGS:			sValue = m_data.FormatTaskTags(pTDI);		break;
+
+		case TDCA_ALLOCBY:		sValue = pTDI->sAllocBy;						break;
+		case TDCA_STATUS:		sValue = pTDI->sStatus;						break;
+		case TDCA_VERSION:		sValue = pTDI->sVersion;						break;
+		case TDCA_EXTERNALID:	sValue = pTDI->sExternalID;					break;
+		case TDCA_Amount:		sValue = pTDI->sAmount;						break;
+		case TDCA_RECURRENCE:	sValue = pTDI->trRecurrence.GetRegularity(FALSE);	break;
+
+		default:
+			ASSERT(0); // not supported by the batched path
+			return EMPTY_STR;
+		}
+	}
+
+	return sValue;
+}
+
+CString CToDoCtrlFind::FormatTaskTimeAttribute(const TODOITEM* pTDI, const TODOSTRUCTURE* pTDS,
+											 int nDefUnits, BOOL bTimeEst) const
+{
+	CString sTime;
+
+	if (pTDI && pTDS)
+	{
+		int nUnits = nDefUnits;
+
+		// get actual task time units
+		if (!pTDS->HasSubTasks() || m_data.HasStyle(TDCS_ALLOWPARENTTIMETRACKING))
+			nUnits = bTimeEst ? pTDI->nTimeEstUnits : pTDI->nTimeSpentUnits;
+
+		double dTime = bTimeEst ? m_data.CalcTimeEstimate(pTDI, pTDS, nUnits)
+							   : m_data.CalcTimeSpent(pTDI, pTDS, nUnits);
+
+		if ((dTime != 0.0) || !m_data.HasStyle(TDCS_HIDEZEROTIMECOST))
+		{
+			if (!bTimeEst || (dTime > 0.0))
+			{
+				int nDecPlaces = m_data.HasStyle(TDCS_ROUNDTIMEFRACTIONS) ? 0 : 2;
+
+				if (m_data.HasStyle(TDCS_DISPLAYHMSTIMEFORMAT))
+					sTime = CTimeHelper().FormatTimeHMS(dTime, nUnits, (BOOL)nDecPlaces);
+				else
+					sTime = CTimeHelper().FormatTime(dTime, nUnits, nDecPlaces);
+			}
+		}
+	}
+
+	return sTime;
+}
+
+void CToDoCtrlFind::GetLongestValues(GLVBATCH& batch) const
+{
+	batch.aResults.RemoveAll();
+	batch.aResults.SetSize(batch.aAttribs.GetSize());
+
+	for (int nAttr = 0; nAttr < batch.aAttribs.GetSize(); nAttr++)
+		batch.aResults[nAttr] = (nAttr < batch.aInitial.GetSize()) ? batch.aInitial[nAttr] : EMPTY_STR;
+
+	GetLongestValues(batch, NULL, NULL);
+}
+
+void CToDoCtrlFind::GetLongestValues(GLVBATCH& batch, HTREEITEM hti, const TODOITEM* pTDI) const
+{
+	const TODOSTRUCTURE* pTDS = NULL;
+
+	if (hti && !pTDI)
+		pTDI = GetTask(hti);
+
+	if (hti && batch.bNeedTDS)
+	{
+		DWORD dwTaskID = GetTaskID(hti);
+
+		if (!m_data.GetTask(dwTaskID, pTDI, pTDS))
+		{
+			pTDI = NULL;
+			pTDS = NULL;
+		}
+	}
+
+	if (pTDI)
+	{
+		for (int nAttr = 0; nAttr < batch.aAttribs.GetSize(); nAttr++)
+		{
+			CString sValue;
+			const int nAttrib = batch.aAttribs[nAttr];
+
+			switch (nAttrib)
+			{
+			case TDCA_TIMEEST:		sValue = FormatTaskTimeAttribute(pTDI, pTDS, batch.nDefTimeUnits, TRUE);	break;
+			case TDCA_TIMESPENT:	sValue = FormatTaskTimeAttribute(pTDI, pTDS, batch.nDefTimeUnits, FALSE);	break;
+			default:				sValue = FormatTaskAttribute(nAttrib, pTDI);								break;
+			}
+
+			if (sValue.GetLength() > batch.aResults[nAttr].GetLength())
+				batch.aResults[nAttr] = sValue;
+		}
+	}
+
+	if (WantSearchChildren(hti, batch.bVisibleOnly))
+	{
+		HTREEITEM htiChild = m_tree.GetChildItem(hti);
+
+		while (htiChild)
+		{
+			GetLongestValues(batch, htiChild, NULL);
+			htiChild = m_tree.GetNextItem(htiChild, TVGN_NEXT);
+		}
+	}
+}
