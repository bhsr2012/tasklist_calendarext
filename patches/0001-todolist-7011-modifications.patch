+
+		void AddUnique(CStringArray& aItems, CMap<CString, LPCTSTR, int, int&>& map, const CString& sValue)
+		{
+			CString sItem(sValue);
+			Misc::Trim(sItem);
+
+			if (sItem.IsEmpty())
