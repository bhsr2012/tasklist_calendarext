+LRESULT CEnToolBar::OnItemPrePaint(LPNMTBCUSTOMDRAW lpNMCustomDraw)
+{
+	if (HasBkgndColor())
+	{
+		CDC* pDC = CDC::FromHandle(lpNMCustomDraw->nmcd.hdc);
+		CRect rc(lpNMCustomDraw->nmcd.rc);
+
+		// Fill the button area with the toolbar background instead of the
+		// themed grey button face, then draw the icon transparently on top.
+		if (m_crTo == m_crFrom)
+			pDC->FillSolidRect(rc, m_crFrom);
+		else
+		{
+			GM_GRADIENT nType = GraphicsMisc::GetGradientType(m_bGlass, m_bGradient);
+			GraphicsMisc::DrawGradient(nType, pDC, rc, m_crFrom, m_crTo, FALSE);
+		}
+
+		int nBtn = CommandToIndex((UINT)lpNMCustomDraw->nmcd.dwItemSpec);
+		TBBUTTON btn;
+		ZeroMemory(&btn, sizeof(btn));
+
+		if ((nBtn >= 0) && GetToolBarCtrl().GetButton(nBtn, &btn) &&
+			!(btn.fsStyle & TBSTYLE_SEP) && (btn.iBitmap >= 0))
+		{
+			CImageList* pIL = (lpNMCustomDraw->nmcd.uItemState & CDIS_DISABLED)
+							? &m_ilDisabled : &m_ilNormal;
+
+			if (pIL && pIL->GetSafeHandle())
+			{
+				CPoint pt(rc.left + (rc.Width() - m_sizeImage.cx) / 2,
+						  rc.top + (rc.Height() - m_sizeImage.cy) / 2);
+				pIL->Draw(pDC, btn.iBitmap, pt, ILD_TRANSPARENT);
+			}
+		}
+
+		return CDRF_SKIPDEFAULT;
+	}
+
+	return CDRF_DODEFAULT;
+}
