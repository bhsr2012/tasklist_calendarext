+BOOL CTDCTaskCtrlBase::GetLongestValueAttrib(TDC_COLUMN nColID, int& nAttrib)
+{
+	nAttrib = TDCA_NONE;
+
+	switch (nColID)
+	{
+	case TDCC_STATUS:
+		nAttrib = TDCA_STATUS;
+		break;
+
+	case TDCC_TIMEEST:
+		nAttrib = TDCA_TIMEEST;
+		break;
+
+	case TDCC_TIMESPENT:
+		nAttrib = TDCA_TIMESPENT;
+		break;
+
+	case TDCC_RECURRENCE:
+	case TDCC_EXTERNALID:
+	case TDCC_VERSION:
+	case TDCC_ALLOCBY:
+	case TDCC_Amount:
+	case TDCC_ALLOCTO:
+	case TDCC_CATEGORY:
+	case TDCC_TAGS:
+	case TDCC_EQUIPMENT:
+		nAttrib = TDC::MapColumnToAttribute(nColID);
+		break;
+
+	default:
+		// everything else is either fixed width or needs the subtask aware
+		// GetLongestValue overload (COST/PATH/POSITION/SUBTASKDONE)
+		return FALSE;
+	}
+
+	return (nAttrib != TDCA_NONE);
+}
+
+BOOL CTDCTaskCtrlBase::LookupLongestValue(int nAttrib, CString& sValue) const
+{
+	if (!m_bBatchValid || (nAttrib == TDCA_NONE))
+		return FALSE;
+
+	for (int nSlot = 0; nSlot < m_batchLongest.aAttribs.GetSize(); nSlot++)
+	{
+		if ((m_batchLongest.aAttribs[nSlot] == nAttrib) &&
+			(nSlot < m_batchLongest.aResults.GetSize()))
+		{
+			sValue = m_batchLongest.aResults[nSlot];
+			return TRUE;
+		}
+	}
+
+	return FALSE;
+}
