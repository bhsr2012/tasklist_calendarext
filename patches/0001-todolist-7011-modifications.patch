+static HWND FindInstanceFrame()
+{
+	struct Local
+	{
+		static BOOL CALLBACK Scan(HWND hWnd, LPARAM lParam)
+		{
+			TCHAR szCls[64] = { 0 };
+			::GetClassName(hWnd, szCls, _countof(szCls));
+			if (_tcsicmp(szCls, _T("ToDoListFrame")) != 0)
+				return TRUE;
+
+			DWORD dwPid = 0;
+			::GetWindowThreadProcessId(hWnd, &dwPid);
+			if (dwPid == ::GetCurrentProcessId())
+				return TRUE;
+
+			HWND* pHit = (HWND*)lParam;
+			if (*pHit == NULL || ::IsWindowVisible(hWnd))
+				*pHit = hWnd;
+
+			return (*pHit != NULL && ::IsWindowVisible(*pHit)) ? FALSE : TRUE;
+		}
+	};
+
+	HWND hWnd = ::FindWindow(_T("ToDoListFrame"), NULL);
+	if (hWnd != NULL && ::IsWindow(hWnd))
+		return hWnd;
+
+	HWND hFound = NULL;
+	::EnumWindows(Local::Scan, (LPARAM)&hFound);
+	return hFound;
+}
