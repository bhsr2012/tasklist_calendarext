+void CToDoCtrl::OnCollapseEditPanel()
+{
+	SetCollapseTaskEdit(!m_bCollapseTaskEdit);
+
+	// remember the state for next time. CPreferences is a process-wide shared
+	// map that only reaches disk when its last reference dies, so the value must
+	// go in there: writing straight to the profile file would be overwritten by
+	// the stale value cached at startup when the app shuts down.
+	CPreferences prefs;
+	prefs.WriteProfileInt(_T("Settings"), _T("CollapseTaskEdit"), m_bCollapseTaskEdit);
+
+	// and straight to disk as well so an unclean shutdown keeps the state
+	AfxGetApp()->WriteProfileInt(_T("Settings"), _T("CollapseTaskEdit"), m_bCollapseTaskEdit);
+}
